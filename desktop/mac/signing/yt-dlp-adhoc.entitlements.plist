<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ad-hoc builds only (local testing). Ad-hoc signatures have no Team ID, so library
       validation would refuse yt-dlp's own Python library. A Developer ID build signs
       every library with the same Team ID and does not use this file. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
